# ─────────────────────────────────────────────
# BCRedupath — required environment variables
# by Bibin CutRiver
# Copy this file to .env.local and fill in values
# ─────────────────────────────────────────────

# MongoDB Atlas connection string
# Free cluster: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/bcredupath?retryWrites=true&w=majority

# NextAuth
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-me-with-a-32-char-secret

# Google OAuth (https://console.cloud.google.com → OAuth client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anthropic Claude — for predictor + similar-question generation
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: Cloudinary for image uploads (diagrams, avatars)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Email sending (for password reset)
# Without this, reset emails are printed to the dev-server console (good for testing).
# Sign up at https://resend.com (free 3K emails/month), verify domain, paste key here.
RESEND_API_KEY=
EMAIL_FROM=BCRedupath <noreply@yourdomain.com>

# Optional: Admin access (PYQ import + question verification)
# Comma-separated list of emails. Users with these emails get the Admin tab.
# Alternatively, set user.role = "admin" directly in Mongo.
ADMIN_EMAILS=
